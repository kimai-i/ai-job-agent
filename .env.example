# Copy this file to .env.local and fill in values from:
# Supabase Dashboard > Project Settings > API Keys (and Data API for the URL)
# Only the PUBLIC publishable key belongs here. Never put a secret / service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
